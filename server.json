{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simonmak-ascent/vision-driven-design",
  "title": "Vision Driven Design (VDD) MCP Server",
  "description": "Spec-driven development MCP server: 8 phases, bi-directional traceability, 7 quality gates.",
  "version": "1.9.2",
  "repository": {
    "url": "https://github.com/simonmak-ascent/vision-driven-design",
    "source": "github",
    "subfolder": "packages/vdd-mcp"
  },
