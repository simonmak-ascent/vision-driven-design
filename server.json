        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@simonmak-ascent/mcp",
      "version": "1.9.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
