# VDD MCP — example environment.
#
# Copy to `.env` for local use. NEVER commit real secrets: `.gitignore` ignores
# `.env` and `.env.*` and allows only this file.
#
# The VDD MCP server itself requires no secrets or API keys. Every variable below
# is optional and only affects specific modes.

# Local HTTP transport (packages/vdd-mcp/dist/http-entry.js). Default 3000.
# PORT=3000

# Clone pipeline (vdd_clone) browserless backend — optional. The clone phase
# falls back to plain fetch when unset.
# BROWSERLESS_HOST=http://localhost:3000
# BROWSERLESS_TOKEN=

# npm publish (CI only, e.g. .github/workflows/publish-npm.yml). Never commit a
# real value.
# NODE_AUTH_TOKEN=
